{
  "name": "elecxstock",
  "productName": "elecxstock",
  "version": "0.1.2",
  "private": true,
  "description": "A local-first, keyboard-driven desktop app for charting and screening Japanese stocks and J-REITs.",
  "keywords": [
    "stocks",
    "j-reit",
    "screener",
    "charts",
    "electron",
    "svelte"
  ],
  "homepage": "https://github.com/kurouna/elecxstock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurouna/elecxstock.git"
  },
  "bugs": {
    "url": "https://github.com/kurouna/elecxstock/issues"
  },
  "license": "MIT",
  "author": "kurouna",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && node scripts/gen-notices.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test-renderer.json --noEmit && svelte-check --tsconfig tsconfig.web.json --threshold warning",
    "test": "vitest run",
    "test:fast": "vitest run --project unit",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary && node scripts/coverage-check.mjs",
    "trace": "node scripts/trace.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run trace",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:screenshots": "node scripts/gen-screenshots.mjs",
    "gen:fields-doc": "node --experimental-strip-types --no-warnings scripts/gen-fields-doc.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:0.1.1": "node scripts/demo-v0.1.1.mjs",
    "demo:0.1.2": "node scripts/demo-v0.1.2.mjs",
    "contract": "vitest run --config vitest.contract.config.ts",
    "package": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --win --dir --publish never",
    "test:packaged": "node scripts/packaged-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "lightweight-charts": "5.3.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yahoo-finance2": "4.0.6",
    "zod": "4.6.7"
  }
}
