{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!out", "!release", "!docs/mock", "!node_modules", "!test-results", "!playwright-report"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "warn" }
    }
  },
  "overrides": [
    { "includes": ["src/core/**"], "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "paths": { "electron": "Core は Electron を import しない（NFR-A1）" } } } } } } },
    { "includes": ["**/*.svelte"], "linter": { "rules": { "style": { "useConst": "off" }, "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } } } }
  ]
}
